# What this file does
#   Lists files and folders git must never track.
# Why it exists
#   Keeps secrets (.env), the local embedded database and uploaded files (.data) and generated output out of
#   the repository, so nobody commits a password or their personal test data.

# dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# build output
dist/
build/
coverage/
*.tsbuildinfo

# local runtime data (embedded database, local object storage)
.data/
apps/api/.data/

# environment
.env
.env.*
!.env.example

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
