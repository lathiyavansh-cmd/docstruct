# What this file does
#   Tells editors which character set, line ending and indentation to use for each kind of file.
# Why it exists
#   The team edits on different systems and editors; without shared rules, files would mix CRLF and LF, tabs and
#   spaces, and every save would add noise to the diffs.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
