// What this file does
//   TypeScript settings for the web client: strict checks, React JSX, Vite types and the '@/...' path alias.
// Why it exists
//   `npm run typecheck` and `npm run build` run tsc with this file, so type errors stop a release; the
//   "development" condition makes tsc read @docstruct/shared from source, the same way Vite does.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": [
      "development"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
