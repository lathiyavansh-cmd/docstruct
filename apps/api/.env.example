# What this file does
#   Example settings for the API server. It holds no real secrets and is safe to commit.
#
# How it works
#   - Each line is NAME=value and becomes an environment variable for the API.
#   - Lines starting with # are comments or optional settings switched off.
#   - src/config.ts reads these names and uses its own defaults when one is missing.
#
# Where it fits
#   Copied to apps/api/.env by scripts/setup.mjs; the npm scripts load .env when it exists.
#   Module: server core (owner: Vansh).
#
# Copy to apps/api/.env and adjust. Every value is optional in development.

PORT=4000
# Origin of the web client (CORS and password-reset links)
APP_URL=http://localhost:5173

# Database. Leave empty for the embedded PostgreSQL (PGlite) stored in DATA_DIR,
# or point at any PostgreSQL 15+ server, e.g. a Supabase project's connection string:
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=
DATA_DIR=.data
# STORAGE_DIR=.data/objects

# Secret for signed file URLs. Required in production; generated automatically in development.
# SIGNING_SECRET=

# Appendix C TBD values
# Logout after 30 idle minutes, any session ends after 12 hours, file links last 300 seconds,
# reset links last 30 minutes.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
SIGNED_URL_TTL_SECONDS=300
RESET_TOKEN_MINUTES=30

# Text extraction: "python" runs services/extractor; "builtin" handles TXT/MD only.
EXTRACTOR=python
# PYTHON_BIN=py
